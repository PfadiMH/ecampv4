{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "php /app/bin/console doctrine:migrations:migrate --no-interaction --all-or-nothing"
    ],
    "startCommand": "sh /app/bin/railway-start.sh",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1,
    "sleepApplication": true
  }
}
